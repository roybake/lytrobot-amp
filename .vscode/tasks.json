{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DSH: 启动 Web UI",
      "type": "process",
      "command": "/home/yeah/.local/bin/dsh",
      "args": [
        "web"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "dsh",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^dsh web:",
          "endsPattern": "^dsh web: http://127\\.0\\.0\\.1:3080$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
